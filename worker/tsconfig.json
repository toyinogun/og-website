{
	// Types the Worker in worker/ with the Workers runtime types from
	// `npx wrangler types` (worker-configuration.d.ts), apart from the site's
	// Astro and Node types. It also checks src/lib/contact.ts, which the page and
	// the Worker share (spec 0006).
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ES2024"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": [],
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["./**/*.ts", "../src/lib/contact.ts"]
}
