---
// The one button style, in two variants (design.md, Component values: Button).
// A link when given `href`, otherwise a real button. No disabled state.

/** Props for `Button`. */
interface Props {
	/** `primary` (accent fill) or `secondary` (outlined). Defaults to `primary`. */
	variant?: 'primary' | 'secondary';
	/** Renders an `<a href>` when set, otherwise a `<button>`. */
	href?: string;
	/** The button type when no `href` is given. Defaults to `button`. */
	type?: 'button' | 'submit';
	/** Extra layout classes; never colour. */
	class?: string;
}

const VARIANTS = {
	primary:
		'border-accent bg-accent text-on-accent hover:border-accent-strong hover:bg-accent-strong hover:text-on-accent active:border-accent-strong active:bg-accent-strong',
	secondary:
		'border-line bg-transparent text-text hover:border-accent hover:text-accent active:border-accent-strong active:text-accent-strong',
} as const;

const { variant = 'primary', href, type = 'button', class: className } = Astro.props;

const classes = [
	'inline-flex min-h-11 cursor-pointer items-center justify-center rounded-sm border px-4.5 font-sans text-base font-semibold no-underline transition-colors duration-(--duration-fast)',
	VARIANTS[variant],
	className,
];
---

{
	href ? (
		<a href={href} class:list={classes}>
			<slot />
		</a>
	) : (
		<button type={type} class:list={classes}>
			<slot />
		</button>
	)
}
