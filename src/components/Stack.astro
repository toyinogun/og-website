---
// Vertical spacing between children at one of four gaps (design.md, Space and
// layout: sm 0.75rem, md 1.5rem, lg 3rem, xl 5rem).

/** Props for `Stack`. */
interface Props {
	/** Space between children. Defaults to `md`. */
	gap?: 'sm' | 'md' | 'lg' | 'xl';
	/** The element to render. Defaults to `div`. */
	as?: 'div' | 'ul' | 'ol';
	/** Extra layout classes; never colour. */
	class?: string;
}

const GAPS = { sm: 'gap-3', md: 'gap-6', lg: 'gap-12', xl: 'gap-20' } as const;

const { gap = 'md', as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['flex flex-col', GAPS[gap], className]}>
	<slot />
</Tag>
