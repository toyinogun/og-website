---
// Placeholder home page. It exists so the dev server and the production build
// have something real to render; feature 7 designs and builds the actual home
// page.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Toyin Ogunseinde"
	description="Personal site of Toyin Ogunseinde. Under construction."
>
	<main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center gap-4 p-8">
		<h1 class="text-3xl font-semibold tracking-tight">Toyin Ogunseinde</h1>
		<p class="text-base opacity-70">
			This site is being built. The scaffold runs, so the real pages can land on top of it.
		</p>
	</main>
</BaseLayout>
