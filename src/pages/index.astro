---
// The home page (spec 0004): what you do and how to reach you first, then the
// closing call to action. The words live in `HOME` (src/lib/home.ts).
import CallToAction from '../components/CallToAction.astro';
import Container from '../components/Container.astro';
import PageIntro from '../components/PageIntro.astro';
import Section from '../components/Section.astro';
import Stack from '../components/Stack.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { HOME } from '../lib/home';
---

<BaseLayout title={HOME.title} description={HOME.description}>
	<Container>
		<PageIntro size="display" eyebrow={HOME.availability} heading={HOME.heading} lead={HOME.lead}>
			<CallToAction class="w-full sm:w-auto sm:self-start" />
		</PageIntro>
		<Section id="contact" heading={HOME.closingHeading}>
			<Stack>
				<p class="max-w-measure">{HOME.closingText}</p>
				<CallToAction class="w-full sm:w-auto sm:self-start" />
			</Stack>
		</Section>
	</Container>
</BaseLayout>
