---
// The home page (spec 0004): what you do and how to reach you first, then the
// featured projects, up to three quotes (spec 0009), the first bio paragraph with a link to the About page,
// and the closing call to action.
// The words live in `HOME` (src/lib/home.ts), the bio in src/content/bio.md.
import { getCollection } from 'astro:content';
import CallToAction from '../components/CallToAction.astro';
import Container from '../components/Container.astro';
import PageIntro from '../components/PageIntro.astro';
import Section from '../components/Section.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Stack from '../components/Stack.astro';
import Testimonials from '../components/Testimonials.astro';
import bioSource from '../content/bio.md?raw';
import BaseLayout from '../layouts/BaseLayout.astro';
import siteCard from '../assets/share/site-card.png';
import { getImage } from 'astro:assets';
import { HOME } from '../lib/home';
import { absoluteUrl, personGraph, SHARE_IMAGE_OPTIONS } from '../lib/seo';
import { featuredProjects, visibleProjects } from '../lib/projects';
import { homeTestimonials, sortTestimonials, testimonialView } from '../lib/testimonials';
import { firstParagraph } from '../lib/text';

const visible = visibleProjects(await getCollection('projects'), {
	includeDrafts: import.meta.env.DEV,
});
const featured = featuredProjects(visible);
const quotes = homeTestimonials(sortTestimonials(await getCollection('testimonials'))).map(
	(entry) => testimonialView(entry, visible),
);
const site = Astro.site ?? Astro.url;
const cardImage = await getImage({ src: siteCard, ...SHARE_IMAGE_OPTIONS });
const graph = personGraph({ site, imageUrl: absoluteUrl(cardImage.src, site) });
---

<BaseLayout title={HOME.title} description={HOME.description} structuredData={graph}>
	<Container>
		<PageIntro size="display" eyebrow={HOME.availability} heading={HOME.heading} lead={HOME.lead}>
			<CallToAction class="w-full sm:w-auto sm:self-start" />
		</PageIntro>
		<SelectedWork projects={featured} heading={HOME.workHeading} />
		<Testimonials
			id="testimonials"
			heading={HOME.testimonialsHeading}
			projectLabel={HOME.testimonialsProjectLabel}
			testimonials={quotes}
		/>
		<Section id="about" heading={HOME.aboutHeading}>
			<Stack>
				<p class="max-w-measure">{firstParagraph(bioSource)}</p>
				<a href="/about" class="inline-flex min-h-6 items-center self-start">{HOME.aboutLink}</a>
			</Stack>
		</Section>
		<Section id="contact" heading={HOME.closingHeading}>
			<Stack>
				<p class="max-w-measure">{HOME.closingText}</p>
				<CallToAction class="w-full sm:w-auto sm:self-start" />
			</Stack>
		</Section>
	</Container>
</BaseLayout>
